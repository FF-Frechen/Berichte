# Feuerwehr Berichte System - Environment Variables
# ==================================================
# Kopiere diese Datei zu ".env" und fülle deine Werte ein:
#   cp .env.example .env
#
# Diese Datei wird verwendet von:
# - docker-compose.yml (lokale Entwicklung)
# - portainer-stack.yml (Portainer Deployment - Variablen dort manuell eingeben)

# SMTP-Konfiguration für E-Mail-Versand
# --------------------------------------
# Port 587 mit STARTTLS ist Standard (SMTP_SECURE=false)
# Port 465 mit SSL/TLS benötigt SMTP_SECURE=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=deine-email@example.com
SMTP_PASS=dein-smtp-passwort

# Sicherheit
# ----------
# Passwort zum Löschen von PDF-Dateien
DELETE_PASSWORD=dein-sicheres-passwort

# E-Mail-Empfänger
# ----------------
# Mehrere Empfänger mit Komma trennen (keine Leerzeichen!)

# Empfänger für Einsatzberichte (PDF-Dokumente von Einsätzen)
EMAIL_RECIPIENTS_BERICHT=empfaenger1@example.com,empfaenger2@example.com

# Empfänger für Anwesenheitslisten (Übungen, Dienste, etc.)
EMAIL_RECIPIENTS_ANWESENHEIT=empfaenger1@example.com

# Empfänger für Sonderdienst-Anwesenheitslisten
EMAIL_RECIPIENTS_SONDER=empfaenger1@example.com

# Automatischer Versand nicht abgeschickter Einsatzberichte
# ---------------------------------------------------------
# Wird ein Einsatzbericht (PDF-Version) gespeichert, aber nicht manuell
# versendet, schickt das System ihn nach Ablauf der Frist automatisch an die
# Empfänger aus EMAIL_RECIPIENTS_BERICHT. Maßgeblich ist die jüngste Version
# je Einsatz; eine neue Version setzt die Frist zurück, ein manueller Versand
# bricht sie ab. Die automatische Mail ist in Betreff und Text deutlich
# als automatischer Versand gekennzeichnet.
# Stichtag: Beim ersten Start nach der Aktivierung merkt sich das System den
# Zeitpunkt. Nur ab dann erstellte Berichte werden automatisch versendet -
# bereits vorhandene (alte) Berichte bleiben unangetastet (kein Massenversand).
# Wartezeit in Stunden (Standard: 6)
AUTO_SEND_HOURS=6
# Prüfintervall in Millisekunden (Standard: 300000 = 5 Minuten)
AUTO_SEND_CHECK_INTERVAL_MS=300000

# Namensliste für Autocomplete
# -----------------------------
# Alle Namen in einer Zeile, mit Komma getrennt
NAMEN=Max Mustermann,Erika Musterfrau,Hans Schmidt,Anna Weber,Tom Fischer

# Namenslisten-Stand (optional)
# ------------------------------
# Datum, das auf der Hauptseite angezeigt wird
# Format: beliebig (z.B. "04.09.2025" oder "4. September 2025")
# Wenn nicht gesetzt: Aktuelles Datum wird verwendet
NAMENSLISTE_STAND=04.09.2025

# Fahrzeugkonfiguration
# ---------------------
# Die Reihenfolge der Fahrzeuge hier bestimmt die Reihenfolge auf der Webseite
# Format:
#   VEHICLE_X_ID = Eindeutige ID (intern)
#   VEHICLE_X_NAME = Name für PDF (kurz)
#   VEHICLE_X_DISPLAY_NAME = Vollständiger Name für Webseite
#   VEHICLE_X_FUNCTIONS = Funktionen/Positionen (komma-separiert)
#
# Hinweis: Das System unterstützt bis zu 50 Fahrzeuge (VEHICLE_1 bis VEHICLE_50)
# Fügen Sie weitere Fahrzeuge nach dem gleichen Muster hinzu

# Fahrzeug 1: HLF 20 /1
VEHICLE_1_ID=hlf20-1
VEHICLE_1_NAME=FRE 1 / HLF 20 /1
VEHICLE_1_DISPLAY_NAME=FRE1/HLF20/1 - Hilfeleistungslöschfahrzeug
VEHICLE_1_FUNCTIONS=Gruppenführer,Maschinist,Angriffstrupp - Führer,Angriffstrupp - Mann,Wassertrupp - Führer,Wassertrupp - Mann,Schlauchtrupp - Führer,Schlauchtrupp - Mann

# Fahrzeug 2: HLF 20 /2
VEHICLE_2_ID=hlf20-2
VEHICLE_2_NAME=FRE 1 / HLF 20 /2
VEHICLE_2_DISPLAY_NAME=FRE1/HLF20/2 - Hilfeleistungslöschfahrzeug
VEHICLE_2_FUNCTIONS=Gruppenführer,Maschinist,Angriffstrupp - Führer,Angriffstrupp - Mann,Wassertrupp - Führer,Wassertrupp - Mann,Schlauchtrupp - Führer,Schlauchtrupp - Mann

# Fahrzeug 3: LF 20 /1
