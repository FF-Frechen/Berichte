VEHICLE_3_DISPLAY_NAME=FRE1/LF20/1 - Löschfahrzeug
VEHICLE_3_FUNCTIONS=Gruppenführer,Maschinist,Angriffstrupp - Führer,Angriffstrupp - Mann,Wassertrupp - Führer,Wassertrupp - Mann,Schlauchtrupp - Führer,Schlauchtrupp - Mann,Melder

