# Portainer Stack Environment Variables
# ======================================
# Kopiere diese Variablen in Portainer unter "Environment variables"
# beim Deployen des Stacks aus portainer-stack.yml

# PFAD-KONFIGURATION
# ------------------
# Option 1: Host-Pfad (Bind Mount) - Pfad zu deinem Einsatzdoku-Verzeichnis
CONFIG_PATH=/pfad/zum/verzeichnis/Einsatzdoku

# Option 2: Docker Named Volume (Empfohlen für Portabilität)
# Wenn CONFIG_PATH nicht gesetzt ist, wird automatisch ein Docker Volume verwendet
# CONFIG_PATH=

# SMTP-KONFIGURATION
# ------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=deine-email@example.com
SMTP_PASS=dein-passwort

# SICHERHEIT
# ----------
DELETE_PASSWORD=dein-lösch-passwort

# E-MAIL-EMPFÄNGER
# ----------------
# Mehrere Empfänger mit Komma trennen
EMAIL_RECIPIENTS=empfaenger1@example.com,empfaenger2@example.com
EMAIL_RECIPIENTS_ANWESENHEIT=empfaenger1@example.com

# NAMENSLISTE
# -----------
# Komma-getrennte Liste aller Feuerwehrmitglieder
NAMEN=Max Mustermann,Erika Musterfrau,Hans Schmidt,Anna Weber,Tom Fischer

# FAHRZEUGKONFIGURATION
# ---------------------
# Die Fahrzeuge und ihre Funktionen müssen einzeln konfiguriert werden.
# Die Reihenfolge (VEHICLE_1, VEHICLE_2, etc.) bestimmt die Reihenfolge auf der Webseite.
# Siehe .env.fahrzeuge.example für alle 13 Standard-Fahrzeuge.
#
# Beispiel für ein Fahrzeug:
VEHICLE_1_ID=hlf20-1
VEHICLE_1_NAME=FRE 1 / HLF 20 /1
VEHICLE_1_DISPLAY_NAME=FRE1/HLF20/1 - Hilfeleistungslöschfahrzeug
VEHICLE_1_FUNCTIONS=Gruppenführer,Maschinist,Angriffstrupp - Führer,Angriffstrupp - Mann,Wassertrupp - Führer,Wassertrupp - Mann,Schlauchtrupp - Führer,Schlauchtrupp - Mann
#
# Weitere Fahrzeuge analog mit VEHICLE_2_*, VEHICLE_3_*, etc. hinzufügen
# Kopiere die vollständige Konfiguration aus .env.fahrzeuge.example
