# SMTP Konfiguration für E-Mail-Versand
# Port 587 mit STARTTLS (SMTP_SECURE muss false sein!)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=deine-email@example.com
SMTP_PASS=dein-smtp-passwort

# Lösch-Passwort für PDF-Dateien
DELETE_PASSWORD=dein-sicheres-passwort

# E-Mail-Empfänger für Einsatzberichte (Komma-separiert)
EMAIL_RECIPIENTS=empfaenger1@example.com,empfaenger2@example.com

# E-Mail-Empfänger für Anwesenheitslisten (Komma-separiert)
EMAIL_RECIPIENTS_ANWESENHEIT=empfaenger1@example.com
